# ============================================
# Complaint Management Portal - Environment Variables
# Copy this file to ".env" and fill in your own values
# ============================================

# Server port
PORT=5000

# MongoDB connection string
# Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/complaint_management_portal
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/complaint_management_portal

# JWT secret key used to sign authentication tokens (use a long random string in production)
JWT_SECRET=super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Default Admin credentials (used to log in to the Admin Dashboard)
ADMIN_EMAIL=admin@complaintportal.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Administrator
